{
  "name": "entertainment-complex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run sync:catalog",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "prestart": "npm run sync:catalog",
    "start": "npm run preview",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "sync:ott": "node scripts/sync-catalog.mjs --ott-only",
    "audit:ott": "node scripts/audit-ott.mjs",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:check": "npm run worker:types && tsc --noEmit && wrangler deploy --dry-run"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "hls.js": "^1.6.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shaka-player": "^4.16.52"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^7.0.2",
    "vite": "^7.1.9",
    "wrangler": "^4.150.0"
  }
}
