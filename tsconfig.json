{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["./worker/worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["worker/src/**/*.ts", "worker/worker-configuration.d.ts"]
}
